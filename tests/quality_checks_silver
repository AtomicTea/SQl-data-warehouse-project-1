/*
*******************************************************************************
Quality Checks
*******************************************************************************
Script Purpose:
    This script performs various quality checks for data consistency, accuracy, 
    and standardization across the 'Silver' layer. It includes checks for:
    - Null or duplicate key values.
    - Unwanted spaces in string fields.
    - Data standardization and consistency.
    - Invalid date ranges and orders.
    - Data consistency between related fields.

Usage Notes:
    - Run these checks after loading Silver Layer.
    - Investigate and resolve any discrepancies found during the checks.
===============================================================================
*/

-- ********************************************************************
-- Checking 'dwport1_silver.crm_cust_info'
-- ********************************************************************
-- Check for NULLs or Duplicates in Primary Key
-- Expectation: No Results
SELECT 
    cst_id,
    COUNT(*) 
FROM dwport1_silver.crm_cust_info
GROUP BY cst_id
HAVING COUNT(*) > 1 OR cst_id IS NULL;

-- Check for Unwanted Spaces
-- Expectation: No Results
SELECT 
    cst_key 
FROM dwport1_silver.crm_cust_info
WHERE cst_key != TRIM(cst_key);

-- Data Standardization & Consistency
SELECT DISTINCT 
    cst_marital_status 
FROM dwport1_silver.crm_cust_info;

-- *******************************************************************
-- Checking 'dwport1_silver.crm_prd_info'
-- *******************************************************************
-- Check for NULLs or Duplicates in Primary Key
-- Expectation: No Results
SELECT 
    prd_id,
    COUNT(*) 
FROM dwport1_silver.crm_prd_info
GROUP BY prd_id
HAVING COUNT(*) > 1 OR prd_id IS NULL;

-- Check for Unwanted Spaces
-- Expectation: No Results
SELECT 
    prd_nm 
FROM dwport1_silver.crm_prd_info
WHERE prd_nm != TRIM(prd_nm);

-- Check for NULLs or Negative Values in Cost
-- Expectation: No Results
SELECT 
    prd_cost 
FROM dwport1_silver.crm_prd_info
WHERE prd_cost < 0 OR prd_cost IS NULL;

-- Data Standardization & Consistency
SELECT DISTINCT 
    prd_line 
FROM dwport1_silver.crm_prd_info;

-- Check for Invalid Date Orders (Start Date > End Date)
-- Expectation: No Results
SELECT 
    * 
FROM dwport1_silver.crm_prd_info
WHERE prd_end_dt < prd_start_dt;

-- *******************************************************************
-- Checking 'dwport1_silver.crm_sales_details'
-- *******************************************************************
-- Check for Invalid Date Relationships
-- Expectation: No Results
SELECT *
FROM dwport1_silver.crm_sales_details
WHERE sls_order_dt > sls_ship_dt
   OR sls_order_dt > sls_due_dt;

-- Check Data Consistency: Sales = Quantity * Price
-- Expectation: No Results
SELECT DISTINCT 
    sls_sales,
    sls_quantity,
    sls_price 
FROM dwport1_silver.crm_sales_details
WHERE sls_sales != sls_quantity * sls_price
   OR sls_sales IS NULL 
   OR sls_quantity IS NULL 
   OR sls_price IS NULL
   OR sls_sales <= 0 
   OR sls_quantity <= 0 
   OR sls_price <= 0
ORDER BY sls_sales, sls_quantity, sls_price;

-- ********************************************************************
-- Checking 'dwport1_silver.erp_cust_az12'
-- ********************************************************************
-- Identify Out-of-Range Dates
-- Expectation: Birthdates between 1924-01-01 and Today
SELECT DISTINCT bdate
FROM dwport1_silver.erp_cust_az12
WHERE bdate < '1924-01-01'
   OR bdate > CURRENT_DATE();

-- Data Standardization & Consistency
SELECT DISTINCT 
    gen 
FROM dwport1_silver.erp_cust_az12;

-- *******************************************************************
-- Checking 'dwport1_silver.erp_loc_a101'
-- *******************************************************************
-- Data Standardization & Consistency
SELECT DISTINCT 
    cntry 
FROM dwport1_silver.erp_loc_a101
ORDER BY cntry;

-- ********************************************************************
-- Checking 'dwport1_silver.erp_px_cat_g1v2'
-- ********************************************************************
-- Check for Unwanted Spaces
-- Expectation: No Results
SELECT 
    * 
FROM dwport1_silver.erp_px_cat_g1v2
WHERE cat != TRIM(cat) 
   OR subcat != TRIM(subcat) 
   OR maintenance != TRIM(maintenance);

-- Data Standardization & Consistency
SELECT DISTINCT 
    maintenance 
FROM dwport1_silver.erp_px_cat_g1v2;
