/*
===============================================================================
Stored Procedure: Load Bronze Layer (Source -> Bronze)
===============================================================================
Script Purpose:
    This stored procedure loads data into the 'bronze' schema from external CSV files. 
    It performs the following actions:
     * Truncates the bronze tables before loading data. 
     * Uses the 'LOAD DATA LOCAL INFILE' command to load data from the csv files to bronze tables.

Parameters:
    None. 
	  This stored procedure does not accept any parameters or return any values.

Exceptions:
     * If you are working within MySQL Workbench, truncating and loading data cannot be completed in 
       batch. Each TRUNCATE and each LOAD DATA LOCAL INFILE must be 
       performed separately to work within the parameters of MySQL Workbench.
===============================================================================

*/

TRUNCATE TABLE dwport1_bronze.crm_cust_info;

LOAD DATA LOCAL INFILE '<PROJECT_PATH>/datasets/source_crm/cust_info.csv'
INTO TABLE dwport1_bronze.crm_cust_info
FIELDS TERMINATED BY ','
LINES TERMINATED BY '\r\n'
IGNORE 1 ROWS;


