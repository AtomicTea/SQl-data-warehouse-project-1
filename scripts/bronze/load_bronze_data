/*
===============================================================================
Load Bronze Layer (Source -> Bronze)
===============================================================================
Script Purpose:
    This procedure loads raw datafrom source CSV files into the
'Bronze' schema. 
    It performs the following actions:
	* Truncates the Bronze tables before loading new data. 
	* Uses the 'LOAD DATA LOCAL INFILE' command to load data from the source CSV files into the 
       corresponding Bronze tables.
	* Preserves the source data in its raw form for downstream processing in the Silver layer.

Parameters:
    None. 
	  This procedure does not accept any parameters or return any values.

===============================================================================

*/

TRUNCATE TABLE dwport1_bronze.crm_cust_info;

LOAD DATA LOCAL INFILE '<PROJECT_PATH>/datasets/source_crm/cust_info.csv'
INTO TABLE dwport1_bronze.crm_cust_info
FIELDS TERMINATED BY ','
LINES TERMINATED BY '\r\n'
IGNORE 1 ROWS;


